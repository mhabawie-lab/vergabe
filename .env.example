# SicherVergabe — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# See CLAUDE.md, section "Sicherheit & Secrets".

# --- Supabase -----------------------------------------------------------
# Public values, safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — must never reach the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Direct Postgres connection, used by the Supabase CLI to apply
# migrations. The application itself talks to Postgres through the Supabase
# client above and does not read this value.
DATABASE_URL=

# --- Ingestion ----------------------------------------------------------
# Shared secret protecting /api/v1/internal/* (connector + normalizer triggers).
# Generate with: openssl rand -hex 32
INGESTION_TRIGGER_SECRET=

# --- AI (phase 3, not used yet) -----------------------------------------
# Server-only. Leave empty until the AI analysis pipeline is implemented.
ANTHROPIC_API_KEY=

# --- Reference data (phase 2) -------------------------------------------
# No additional variables are required. Customer and reference data use the
# same Supabase connection as everything else.
#
# Without NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY the app
# falls back to a volatile in-process store: reference data is then lost on
# restart, and the UI says so. Do not import real customer data into it.

# --- Application --------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=info
