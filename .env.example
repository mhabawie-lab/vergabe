# SicherVergabe — Umgebungsvariablen
#
# Diese Datei enthält ausschließlich Platzhalter. Echte Werte gehören in
# .env.local (lokal) bzw. in die Secret-Verwaltung der Deployment-Umgebung —
# niemals ins Repository (CLAUDE.md § 5).
#
# Vollständige Beschreibung: docs/environment-variables.md

# --- Datenbackend ----------------------------------------------------------
# supabase | memory. Ohne Angabe wird abgeleitet; in der Produktion bricht der
# Start ab, statt still auf den flüchtigen Speicher auszuweichen.
DATA_BACKEND=

# Nur für eine bewusste, dokumentierte Ausnahme. Sonst leer lassen.
ALLOW_MEMORY_BACKEND_IN_PRODUCTION=

# --- Supabase --------------------------------------------------------------
# Projekt-URL, öffentlich.
NEXT_PUBLIC_SUPABASE_URL=

# Für den Browser vorgesehener Schlüssel. Unterliegt Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Veraltet: früherer Name desselben Schlüssels. Wird übergangsweise noch
# gelesen, erzeugt aber einen Hinweis. Bitte auf PUBLISHABLE umstellen.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig. Umgeht RLS vollständig. Niemals in den Browser geben,
# niemals für normale Benutzerabfragen verwenden.
SUPABASE_SECRET_KEY=

# Veraltet: früherer Name des Secret Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Projektreferenz für die Supabase CLI (supabase link --project-ref …).
SUPABASE_PROJECT_REF=

# Direkte PostgreSQL-Verbindung. Nur für CLI, psql und Migrationsprüfungen.
DATABASE_URL=

# --- Speicher --------------------------------------------------------------
# Gültigkeit signierter Download-Links in Sekunden. 30–3600, Standard 300.
STORAGE_SIGNED_URL_TTL_SECONDS=

# --- Sonstiges -------------------------------------------------------------
# Schützt /api/v1/internal/*.
INGESTION_TRIGGER_SECRET=

# Erst ab der KI-Phase relevant, aktuell ungenutzt.
ANTHROPIC_API_KEY=

# debug | info | warn | error
LOG_LEVEL=
