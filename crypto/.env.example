# CryptoRadar — Umgebungsvariablen
#
# Diese Datei dokumentiert die benötigten Variablen OHNE echte Werte.
# Echte Werte gehören in .env.local und niemals ins Repository.
#
# Ohne jede Konfiguration läuft die App vollständig im DEMO-Modus:
# synthetische Kurse, erfundene Beiträge, alles sichtbar gekennzeichnet.

# --- Marktdaten -------------------------------------------------------------
# Reihenfolge der Kursquellen. Die erste erreichbare gewinnt; demo ist der
# letzte Rückfall und wird immer angehängt.
MARKET_SOURCES=binance,coingecko,demo

# --- Social & Nachrichten ---------------------------------------------------
# Welche Quellen abgefragt werden.
SOCIAL_SOURCES=x,reddit,news,demo

# X (Twitter) API v2. Das Lesen von Posts erfordert einen kostenpflichtigen
# Plan (Basic oder höher). Ohne Token wird die Quelle übersprungen.
X_BEARER_TOKEN=

# Reddit funktioniert ohne Zugangsdaten. Ein eigener User-Agent verhindert,
# dass Reddit die Abfragen drosselt.
REDDIT_USER_AGENT=cryptoradar/0.1 (self-hosted market research)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Eigene RSS-/Atom-Feeds, kommagetrennt. Leer = eingebaute Standard-Feeds.
NEWS_FEED_URLS=

# --- Live-Handel ------------------------------------------------------------
# NICHT AKTIVIEREN, solange die Strategie nicht im Papierhandel bewiesen ist.
# Die Live-Anbindung ist bewusst noch nicht implementiert; dieser Schalter
# existiert, damit der Papierhandel nie versehentlich echte Orders auslöst.
LIVE_TRADING_ENABLED=false
# Falls Live-Handel später aktiviert wird: API-Key OHNE Auszahlungsrechte
# ("Withdrawal" auf der Börse deaktivieren) und IP-Beschränkung setzen.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
